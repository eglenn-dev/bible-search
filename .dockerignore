# This file specifies files and directories to ignore when building the Docker image.

__pycache__/
*.pyc
*.pyo
*.pyd
.env
*.db
*.sqlite3
*.log
*.egg-info/
dist/
build/
docs/
src/
.next/
*.egg
*.whl
*.tar.gz
*.zip
*.tar
*.gz
*.tgz
*.bak
*.swp
.DS_Store
Thumbs.db
.vscode/

# Frontend is built/deployed separately; the image is API-only.
client/
node_modules/

# Local virtualenvs (the image builds its own via uv)
**/.venv/

# Ingestion-only and now-unused artifacts (not needed by the runtime API).
**/.cache*/
api/data/*.faiss
api/data/*.ipynb
.mypy_cache/