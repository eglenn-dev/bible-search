# MongoDB Atlas connection. The user supplies the real SRV URI.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database + collection that hold all corpora (bible | conference | handbook).
MONGODB_DB=gospel_library
MONGODB_COLLECTION=documents

# Embedding version the API searches with (see api/embeddings.py and
# docs/embedding-migration.md). Only v2 exists: e5-small-v2 on `embedding_v2`.
# EMBEDDING_VERSION=v2
# Versions ingestion writes for new/updated docs (default: the active one).
# During a future model migration, list both versions (e.g. v2,v3).
# EMBEDDING_WRITE_VERSIONS=v2

# Name of v2's Atlas Vector Search index.
# VECTOR_INDEX_NAME_V2=vector_index_v2

# Collection that stores logged user searches (analytics). Kept separate from the
# corpus collection so it never touches the vector index.
MONGODB_QUERY_LOG_COLLECTION=query_logs

# Optional: set to 0/false to disable query logging entirely. Defaults to on.
# LOG_QUERIES=1

# Optional: comma-separated CORS origins (defaults baked into app.py if unset).
# ALLOWED_ORIGINS=https://gospel.help,http://localhost:5173

# Optional: per-IP rate limit for the REST API (slowapi syntax). Default 100/minute.
# RATE_LIMIT=100/minute

# Optional: headers the edge sets to the caller's IP, tried in order (then the
# socket peer). List only headers the edge always overwrites: Cloudflare, in
# front of Render, overwrites CF-Connecting-IP; a client can forge
# True-Client-IP and X-Forwarded-For's first entry.
# CLIENT_IP_HEADERS=cf-connecting-ip

# Ask mode (docs/ask.md). Without a key, POST /ask returns 503.
# ANTHROPIC_API_KEY=
# ASK_ENABLED=1
# ASK_HOURLY_LIMIT=10
# ASK_DAILY_LIMIT=30
# ASK_DAILY_BUDGET_USD=3
# ASK_MAX_CONCURRENT=4
# ASK_MAX_SEARCHES=4
# ASK_EFFORT=low
# ASK_MODEL=claude-haiku-5-5
# MONGODB_ASK_USAGE_COLLECTION=ask_usage
# MONGODB_ASK_LOG_COLLECTION=ask_logs
# LOG_ASKS=1
