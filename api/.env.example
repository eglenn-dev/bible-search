# MongoDB Atlas connection. The user supplies the real SRV URI.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database + collection that hold all corpora (bible | conference | handbook).
MONGODB_DB=gospel_library
MONGODB_COLLECTION=documents

# Name of the Atlas Vector Search index on the collection.
VECTOR_INDEX_NAME=vector_index

# Collection that stores logged user searches (analytics). Kept separate from the
# corpus collection so it never touches the vector index.
MONGODB_QUERY_LOG_COLLECTION=query_logs

# Optional: set to 0/false to disable query logging entirely. Defaults to on.
# LOG_QUERIES=1

# Optional: comma-separated CORS origins (defaults baked into app.py if unset).
# ALLOWED_ORIGINS=https://bible.eglenn.dev,http://localhost:5173

# Optional: per-IP rate limit for the REST API (slowapi syntax). Default 100/minute.
# RATE_LIMIT=100/minute
