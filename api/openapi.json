{
  "openapi": "3.1.0",
  "info": {
    "title": "Gospel Library Search API",
    "description": "\nSemantic search across the LDS **Standard Works** (Bible, Book of Mormon,\nDoctrine and Covenants, Pearl of Great Price), **General Conference** addresses\n(1971\u2013present), **BYU Speeches** devotionals and forums, and the\n**General Handbook**.\n\nQueries are matched by meaning using sentence embeddings + MongoDB Atlas Vector\nSearch. Every result links back to the passage on churchofjesuschrist.org.\nConference and BYU Speeches results can be narrowed to one speaker (names from\n[`/speakers`](/speakers)) and/or a range of years.\n\n- **Interactive docs (Swagger UI):** [`/docs`](/docs)\n- **ReDoc:** [`/redoc`](/redoc)\n- **OpenAPI spec:** [`/openapi.json`](/openapi.json)\n- **MCP server (for AI agents):** `/mcp` (Streamable HTTP)\n",
    "contact": {
      "name": "Ethan Glenn",
      "url": "https://ethanglenn.dev/"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:10000",
      "description": "Local development"
    },
    {
      "url": "https://api.bible.eglenn.dev",
      "description": "Production"
    }
  ],
  "paths": {
    "/search": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Semantic search across all corpora",
        "description": "Encode the query and return the most semantically similar passages.\n\nCombine with `speaker` and/or `year_from`/`year_to` to ask what a given\nspeaker said about a topic in a span of years (conference and BYU\nspeeches only, since only those are attributed and dated).",
        "operationId": "search",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Free-text query to search across all corpora by meaning.",
              "examples": [
                "charity never faileth"
              ],
              "title": "Query"
            },
            "description": "Free-text query to search across all corpora by meaning."
          },
          {
            "name": "k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Number of results to return.",
              "default": 10,
              "title": "K"
            },
            "description": "Number of results to return."
          },
          {
            "name": "sources",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated subset to search. Any of: bible, book-of-mormon, doctrine-and-covenants, pearl-of-great-price, conference, byu-speeches, handbook. Omit to search everything.",
              "examples": [
                "bible,book-of-mormon"
              ],
              "title": "Sources"
            },
            "description": "Comma-separated subset to search. Any of: bible, book-of-mormon, doctrine-and-covenants, pearl-of-great-price, conference, byu-speeches, handbook. Omit to search everything."
          },
          {
            "name": "speaker",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only passages by this speaker. Use a name from /speakers (e.g. 'Jeffrey R. Holland'); any byline spelling or a unique partial name ('Holland' is ambiguous, 'Uchtdorf' is not) also works, and the response's `filters.speaker` shows what it resolved to. Unknown or ambiguous names return 400 with suggestions. Only conference and byu-speeches have speakers, so this narrows results to those sources.",
              "examples": [
                "David A. Bednar"
              ],
              "title": "Speaker"
            },
            "description": "Only passages by this speaker. Use a name from /speakers (e.g. 'Jeffrey R. Holland'); any byline spelling or a unique partial name ('Holland' is ambiguous, 'Uchtdorf' is not) also works, and the response's `filters.speaker` shows what it resolved to. Unknown or ambiguous names return 400 with suggestions. Only conference and byu-speeches have speakers, so this narrows results to those sources."
          },
          {
            "name": "year_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 2100,
                  "minimum": 1800
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only passages from this year or later (inclusive). Only conference and byu-speeches are dated, so a year bound narrows results to those.",
              "examples": [
                2010
              ],
              "title": "Year From"
            },
            "description": "Only passages from this year or later (inclusive). Only conference and byu-speeches are dated, so a year bound narrows results to those."
          },
          {
            "name": "year_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 2100,
                  "minimum": 1800
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only passages from this year or earlier (inclusive). See `year_from`.",
              "examples": [
                2020
              ],
              "title": "Year To"
            },
            "description": "Only passages from this year or earlier (inclusive). See `year_from`."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Empty query, unknown/ambiguous speaker, or year_from > year_to.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Speaker/year filters requested but the live vector index doesn't have those filter fields yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/search/by-reference": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Find passages similar to a known verse",
        "description": "Look up a verse by reference and return similar passages.\n\nReuses the verse's **stored** embedding (no re-encoding) and excludes the\nverse itself from the results. `speaker` / `year_from` / `year_to` work as\non /search (e.g. which talks by a speaker echo this verse).",
        "operationId": "search_by_reference",
        "parameters": [
          {
            "name": "reference",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Exact scripture reference present in the corpus.",
              "examples": [
                "John 3:16"
              ],
              "title": "Reference"
            },
            "description": "Exact scripture reference present in the corpus."
          },
          {
            "name": "k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Number of results to return.",
              "default": 10,
              "title": "K"
            },
            "description": "Number of results to return."
          },
          {
            "name": "sources",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional comma-separated source filter (see /search).",
              "examples": [
                "conference"
              ],
              "title": "Sources"
            },
            "description": "Optional comma-separated source filter (see /search)."
          },
          {
            "name": "speaker",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only passages by this speaker. Use a name from /speakers (e.g. 'Jeffrey R. Holland'); any byline spelling or a unique partial name ('Holland' is ambiguous, 'Uchtdorf' is not) also works, and the response's `filters.speaker` shows what it resolved to. Unknown or ambiguous names return 400 with suggestions. Only conference and byu-speeches have speakers, so this narrows results to those sources.",
              "examples": [
                "David A. Bednar"
              ],
              "title": "Speaker"
            },
            "description": "Only passages by this speaker. Use a name from /speakers (e.g. 'Jeffrey R. Holland'); any byline spelling or a unique partial name ('Holland' is ambiguous, 'Uchtdorf' is not) also works, and the response's `filters.speaker` shows what it resolved to. Unknown or ambiguous names return 400 with suggestions. Only conference and byu-speeches have speakers, so this narrows results to those sources."
          },
          {
            "name": "year_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 2100,
                  "minimum": 1800
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only passages from this year or later (inclusive). Only conference and byu-speeches are dated, so a year bound narrows results to those.",
              "examples": [
                2010
              ],
              "title": "Year From"
            },
            "description": "Only passages from this year or later (inclusive). Only conference and byu-speeches are dated, so a year bound narrows results to those."
          },
          {
            "name": "year_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 2100,
                  "minimum": 1800
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only passages from this year or earlier (inclusive). See `year_from`.",
              "examples": [
                2020
              ],
              "title": "Year To"
            },
            "description": "Only passages from this year or earlier (inclusive). See `year_from`."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Empty query, unknown/ambiguous speaker, or year_from > year_to.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Speaker/year filters requested but the live vector index doesn't have those filter fields yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown reference.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/speakers": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "List speakers available to the speaker filter",
        "description": "Every General Conference / BYU Speeches speaker, normalized.\n\nBylines differ across eras (\"By Elder M. Russell Ballard\", \"M. Russell\nBallard, Jr.\", joint BYU devotionals), so each person's spellings are\ngrouped under one `name` \u2014 the value to pass as `speaker` to /search.\nComputed from the corpus with one read-only aggregation and cached in\nmemory (it only changes when new talks are ingested).",
        "operationId": "list_speakers",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only speakers whose name contains all of these words (case/accent-insensitive), e.g. 'holland'. Omit for everyone.",
              "examples": [
                "holland"
              ],
              "title": "Q"
            },
            "description": "Only speakers whose name contains all of these words (case/accent-insensitive), e.g. 'holland'. Omit for everyone."
          },
          {
            "name": "variants",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Include each speaker's raw byline variants.",
              "default": true,
              "title": "Variants"
            },
            "description": "Include each speaker's raw byline variants."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpeakersResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/verse": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Look up a passage by exact reference",
        "description": "Return a single passage's text + deep link by exact reference.\n\nCovers all scripture corpora (bible, book-of-mormon, doctrine-and-covenants,\npearl-of-great-price). Used by the frontend to validate/preview a reference.",
        "operationId": "get_verse",
        "parameters": [
          {
            "name": "reference",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Exact reference across any Standard Work corpus.",
              "examples": [
                "Alma 32:21"
              ],
              "title": "Reference"
            },
            "description": "Exact reference across any Standard Work corpus."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerseResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown reference.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "Precomputed corpus statistics",
        "description": "Return the precomputed stats-page payload.\n\nA single small document (~100 KB) written offline by ``python -m\ningest.stats`` \u2014 nothing is computed per-request.",
        "operationId": "get_stats",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Stats not generated yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Return service status and confirm the database is reachable.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppliedFilters": {
        "properties": {
          "speaker": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speaker",
            "description": "The speaker the `speaker` param resolved to (canonical name from /speakers), so a partial name like 'Uchtdorf' can be checked."
          },
          "year_from": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year From",
            "description": "Inclusive lower year bound."
          },
          "year_to": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year To",
            "description": "Inclusive upper year bound."
          }
        },
        "type": "object",
        "title": "AppliedFilters"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "examples": [
              "Online!"
            ]
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "HealthResponse"
      },
      "SearchResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "The query that was searched (echoed back)."
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            },
            "type": "array",
            "title": "Results"
          },
          "filters": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AppliedFilters"
              },
              {
                "type": "null"
              }
            ],
            "description": "Speaker / year filters applied, or null when none were set."
          }
        },
        "type": "object",
        "required": [
          "query",
          "results"
        ],
        "title": "SearchResponse"
      },
      "SearchResult": {
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "bible",
              "book-of-mormon",
              "doctrine-and-covenants",
              "pearl-of-great-price",
              "conference",
              "byu-speeches",
              "handbook"
            ],
            "title": "Source",
            "description": "Which corpus the result belongs to."
          },
          "reference": {
            "type": "string",
            "title": "Reference",
            "description": "Human label: verse reference, talk title, or handbook section."
          },
          "text": {
            "type": "string",
            "title": "Text",
            "description": "The matched passage text."
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title",
            "description": "Talk/chapter title; null for scripture verses."
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Deep link to the passage on churchofjesuschrist.org."
          },
          "score": {
            "type": "number",
            "title": "Score",
            "description": "Cosine similarity in [0, 1] \u2014 higher is more relevant."
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "description": "Source-specific metadata (speaker, book, section, \u2026)."
          }
        },
        "type": "object",
        "required": [
          "source",
          "reference",
          "text",
          "url",
          "score"
        ],
        "title": "SearchResult",
        "example": {
          "metadata": {
            "book": "1 John",
            "chapter": 4,
            "testament": "nt",
            "translation": "KJV",
            "verse": 8
          },
          "reference": "1 John 4:8",
          "score": 0.888,
          "source": "bible",
          "text": "He that loveth not knoweth not God; for God is love.",
          "url": "https://www.churchofjesuschrist.org/study/scriptures/nt/1-jn/4?id=p8#p8"
        }
      },
      "Speaker": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Normalized name \u2014 pass it as `speaker` to /search.",
            "examples": [
              "Jeffrey R. Holland"
            ]
          },
          "talks": {
            "type": "integer",
            "title": "Talks",
            "description": "Conference talks + BYU speeches attributed to them."
          },
          "sources": {
            "items": {
              "type": "string",
              "enum": [
                "bible",
                "book-of-mormon",
                "doctrine-and-covenants",
                "pearl-of-great-price",
                "conference",
                "byu-speeches",
                "handbook"
              ]
            },
            "type": "array",
            "title": "Sources",
            "description": "Corpora they appear in (conference, byu-speeches)."
          },
          "first_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Year",
            "description": "Year of their earliest talk."
          },
          "last_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Year",
            "description": "Year of their latest talk."
          },
          "variants": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Variants",
            "description": "Raw `metadata.speaker` bylines grouped under this name (titles, initials and joint bylines differ across eras). Omitted when `variants=false`."
          }
        },
        "type": "object",
        "required": [
          "name",
          "talks",
          "sources"
        ],
        "title": "Speaker"
      },
      "SpeakersResponse": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "Number of speakers returned."
          },
          "speakers": {
            "items": {
              "$ref": "#/components/schemas/Speaker"
            },
            "type": "array",
            "title": "Speakers",
            "description": "Most talks first."
          }
        },
        "type": "object",
        "required": [
          "count",
          "speakers"
        ],
        "title": "SpeakersResponse"
      },
      "StatsResponse": {
        "properties": {
          "generated_at": {
            "type": "string",
            "title": "Generated At",
            "description": "UTC ISO-8601 timestamp of when the stats were computed."
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data",
            "description": "Precomputed corpus analytics (speaker stats, word trends, scripture trivia, embedding clusters, \u2026) rendered by the frontend /stats page. Regenerated offline via `python -m ingest.stats`."
          }
        },
        "type": "object",
        "required": [
          "generated_at",
          "data"
        ],
        "title": "StatsResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
